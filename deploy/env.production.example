APP_NAME=Pikado
APP_ENV=production
APP_KEY=CHANGE_ME_APP_KEY
APP_DEBUG=false
APP_URL=https://pikado.nosatipub.com

APP_LOCALE=sr
APP_FALLBACK_LOCALE=sr
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Belgrade

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pikado
DB_USERNAME=pikado
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=pikado.nosatipub.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@nosatipub.com
MAIL_FROM_NAME="Nosati Pub Pikado"

REVERB_APP_ID=CHANGE_ME_REVERB_ID
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_HOST=pikado.nosatipub.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http

VITE_APP_NAME=Pikado
VITE_REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
VITE_REVERB_HOST=pikado.nosatipub.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

PIKADO_ADMIN_NAME=Admin
PIKADO_ADMIN_EMAIL=admin@nosatipub.com
PIKADO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
